<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F5F8F7">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/heading" android:textSize="26sp" android:textStyle="bold" android:textColor="#183B37" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/intro" android:textSize="16sp" />
        <TextView style="@style/FieldLabel" android:text="@string/hours_label" android:labelFor="@id/hours_input" />
        <EditText android:id="@+id/hours_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="numberDecimal"
            android:singleLine="true" android:hint="@string/hours_hint" android:saveEnabled="true" />
        <TextView style="@style/FieldLabel" android:text="@string/rate_label" android:labelFor="@id/rate_input" />
        <EditText android:id="@+id/rate_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="numberDecimal"
            android:singleLine="true" android:hint="@string/rate_hint" android:saveEnabled="true" />
        <TextView style="@style/FieldLabel" android:text="@string/tax_label" android:labelFor="@id/tax_input" />
        <EditText android:id="@+id/tax_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="numberDecimal"
            android:singleLine="true" android:hint="@string/tax_hint" android:saveEnabled="true" />
        <Button android:id="@+id/calculate_button" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/calculate" />
        <LinearLayout android:id="@+id/results" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"
            android:layout_marginTop="16dp" android:background="#E3F0EA" android:visibility="gone"
            android:accessibilityLiveRegion="polite">
            <TextView style="@style/ResultText" android:text="@string/results_heading" android:textStyle="bold" />
            <TextView android:id="@+id/regular_pay" style="@style/ResultText" />
            <TextView android:id="@+id/overtime_pay" style="@style/ResultText" />
            <TextView android:id="@+id/total_pay" style="@style/ResultText" android:textStyle="bold" />
            <TextView android:id="@+id/tax_amount" style="@style/ResultText" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/tax_note" android:textSize="14sp" />
        <Button android:id="@+id/about_button" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/about_button" />
    </LinearLayout>
</ScrollView>
