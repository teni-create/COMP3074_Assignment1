<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#176B62</item>
        <item name="android:colorPrimary">#155E57</item>
        <item name="android:colorPrimaryDark">#104A44</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ResultText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#183B37</item>
    </style>
</resources>
